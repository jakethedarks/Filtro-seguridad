-- Enviar webhook
local response = nil
local sendSuccess = pcall(function()
    response = requestFunc({
        Url = url,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = encoded
    })
end)

if sendSuccess and response then
    print("✅ Webhook enviado correctamente")
    if response.StatusCode then
        print("Status Code:", response.StatusCode)
    end
else
    print("❌ Error al enviar webhook")
    
    -- Método alternativo con HttpGetAsync
    local altSuccess = pcall(function()
        game:HttpGetAsync(url .. "?payload_json=" .. HttpService:UrlEncode(encoded))
    end)
    
    if altSuccess then
        print("✅ Webhook enviado con método alternativo")
    else
        print("❌ Ambos métodos fallaron")
    end
end
